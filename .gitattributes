# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicit text files
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.kicad_dbl text eol=lf
*.json text eol=lf
Makefile text eol=lf
# Binary files
*.db binary
*.zip binary
*.png binary
*.jpg binary
*.step binary
*.STEP binary
*.stp binary
*.STP binary
*.wrl binary
# Large generated/copied libraries stored via Git LFS
*.pdf filter=lfs diff=lfs merge=lfs -text
*.kicad_sym filter=lfs diff=lfs merge=lfs -text
